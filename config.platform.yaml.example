# 统一投资信息平台配置

server:
  name: "investment-platform"
  port: 8081

store:
  type: "bolt"
  path: "data/platform.db"
  news:
    max_items: 1000
    ttl: 604800

# ── Channels ──────────────────────────────────────────────────────────────────

# 全量镜像：把所有通过过滤的新闻额外推一份到这些渠道。
# 留空 [] 关闭镜像。
mirror_channels: ["wechat-main"]

channels:
  - name: "wechat-main"
    type: "wechat"
    mode: "push"
    webhook: "${WECHAT_WEBHOOK}"

  # discord-push（bot 网关 → forum 频道）已于 2026-06 解耦后彻底移除：
  # discord bot 由 nimbus 独占，news 仅经 discord-webhook 推普通文本频道。
  # 独立 webhook 推送渠道：3 个 webhook 轮询分散，规避 Discord 单 webhook 频控。
  # 普通文本频道（webhook_plain），不创建 forum thread。
  # 需在对应 source 的 sinks 中加入 "discord-webhook" 才会收到消息。
  - name: "discord-webhook"
    type: "discord"
    mode: "push"
    webhook: "${DISCORD_PUSH_WEBHOOK}"
    options:
      webhook_plain: true
      webhooks:
        - "${DISCORD_WEBHOOK_1}"
        - "${DISCORD_WEBHOOK_2}"
        - "${DISCORD_WEBHOOK_3}"

# ── Sources ───────────────────────────────────────────────────────────────────

sources:
  # ── 实时 ──

  # bwenews-live 已移除（2026-07-18）：公共 WS 端口已死（11.5 天仅 3 条，683 次重连失败刷日志），
  # BWE 内容由 bwenews-rss 覆盖。

  # trump-rss 已移除（2026-11-04）：实测 50 条里政策词命中仅 4%，84% 为 FoxNews/民调/
  # 口水类政治评论；真正的关税/行政命令信号由 bloomberg-politics 与快讯源更快覆盖。
  # 需要原话时再从 trump.fm 手动查，不再占实时源位。

  # 2026-07-18 修复：feed 无 <guid> 导致全部条目同 ID 被去重误杀，ID 改为 GUID→Link 回退。
  - name: "bwe-tradfi"
    type: "rss"
    url: "https://ch2rss.fflow.net/BWEtradfi"
    interval: 120
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      # 价值投资口径（2026-11-09）：只直推宏观大事，其余溢出进聚合。
      # 直推预算 3/日；命中 critical 关键词（央行/数据/地缘/系统性风险）不受配额限制。
      ai_policy: bypass
      on_ai_failure: silent
      critical_keywords:
        - "FOMC"
        - "rate decision"
        - "降息"
        - "降准"
        - "加息"
        - "非农"
        - "CPI"
        - "PPI"
        - "关税"
        - "制裁"
        - "停火"
        - "开战"
        - "台海"
        - "霍尔木兹"
        - "债务上限"
        - "违约"
        - "破产"
        - "熔断"
        - "暴跌"
      direct: {max_per_day: 3, priority: 70}
      digest: {max_per_day: 0, priority: 50, briefing_target: news_aggregate}
      default: direct
    options:
      max_age_hours: 2
      send_images: true
      tags: ["机构", "对冲基金", "TradFi"]

  # Kobeissi Letter —— 数据驱动宏观分析，与 bwe-tradfi 互补（bwe=突发标题, Kobeissi=量化背景）
  # 恢复理由: 韩国杠杆爆仓、SA 杠杆分析、对冲基金 flow、ETF 去杠杆等独有深度内容
  - name: "kobeissi-letter"
    type: "rss"
    url: "https://ch2rss.fflow.net/TheKobeissiLetter"
    interval: 300  # 分析型，不需要高频
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      # 独立直推：图表（利率/资产负债表/ETF flow）本身就是信息。
      # 直推限 8 条/日；配额用尽后回落聚合，避免冷启动一次推 20 条。
      ai_policy: bypass
      on_ai_failure: silent
      direct: {max_per_day: 8, priority: 60}
      digest: {max_per_day: 0, priority: 40, briefing_target: news_aggregate}
      default: direct
    options:
      max_age_hours: 12
      send_images: true
      tags: ["宏观", "市场", "分析"]

  # walter-bloomberg 已删除（2026-11-09）：与 bwe-tradfi 同属一条快讯线，跨源重复高，
  # 价值投资口径下删源比调参更省事；关税/地缘由 bwe + bloomberg-markets 覆盖。

  # first-squawk 已移除（2026-11-04）：与 walter-bloomberg 同属一条快讯线，实测头部条目
  # 完全相同（同一伊朗无人机/WTI 标题），保留 walter 一个即可；跨源重复由去重组兜底。

  # MMS News 已移除（2026-06）：ch2rss 代理冻结，最新条目停在 5/27，线上 0 条 / 213 轮，
  # 被 HealthMonitor 反复标记 unhealthy；且为山寨/meme 加密噪音，与 bwenews-live 仅留 BTC/HYPE 的策略相悖。

  # finnhub-market 已移除（2026-07-18）：用户决定彻底废弃 finnhub 源。
  # bwenews-rss 已移除（2026-07-18）：rss-public.bwe-ws.com 上游持续滞后（~38h），每日 5 条且多为
  # 保留 bwe-tradfi（ch2rss）作为 BWE 系出活的唯一通道。

  # - name: "tree-of-alpha"
  #   type: "tree-of-alpha"
  #   interval: 180
  #   sinks: ["wechat-main", "discord-webhook"]
  #   options:
  #     max_age_hours: 6
  #     max_per_fetch: 10
  #     exclude_crypto: true

  # Fed 官方新闻 —— 直连官方 RSS 已恢复可用（TLS 问题已消失，2026-07-18 verified）；
  # 此前切到 Google News 限定 federalreserve.gov 检索，实测混入研究论文/OIG 审计等噪音，故切回官方源。
  # Fed 官员讲话 —— 宏观信号缺口(2026-08-02 新增):Jefferson/Cook/Bowman/Barr/Waller
  - name: "fed-speeches"
    type: "rss"
    url: "https://www.federalreserve.gov/feeds/speeches.xml"
    interval: 900
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      # AI 只做翻译，不参与路由：全部进聚合，受 digest 配额约束。
      ai_policy: bypass
      on_ai_failure: silent
      digest: {max_per_day: 2, priority: 40, briefing_target: news_aggregate}
      default: digest
    options:
      max_age_hours: 12
      fetch_linked_body: false

  - name: "fed-press"
    type: "rss"
    url: "https://www.federalreserve.gov/feeds/press_all.xml"
    interval: 900
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      critical: true
      # critical 也是直推，必须有日上限；否则 Fed 发布日会绕开所有配额。
      critical_max_per_day: 3
      ai_policy: bypass
      on_ai_failure: silent
      direct: {max_per_day: 0, priority: 100}
      default: silent
    options:
      max_age_hours: 12
      fetch_linked_body: true
      linked_body_hosts:
        - "www.federalreserve.gov"
        - "federalreserve.gov"
      linked_body_max_chars: 12000
      require_keywords:
        - "FOMC"
        - "monetary"
        - "interest rate"
        - "Minutes"
        - "projections"
        - "testimony"
        - "discount rate"
      tags: ["央行", "货币政策", "Fed"]

  # Bloomberg 官方 RSS；仅进入美盘前瞻 digest，不抓取文章正文。
  - name: "bloomberg-markets"
    type: "rss"
    url: "https://www.bloomberg.com/feeds/markets/news.rss"
    interval: 300
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      # AI 只做翻译，不参与路由：全部进聚合，受 digest 配额约束。
      ai_policy: bypass
      on_ai_failure: silent
      digest: {max_per_day: 3, priority: 50, briefing_target: news_aggregate}
      default: digest
    options:
      max_age_hours: 4
      fetch_linked_body: false
      exclude_link_patterns:
        - "/videos/"
        - "/live/"
        - "/newsletters/"
        - "/podcasts/"
      tags: ["市场", "并购", "Bloomberg"]

  - name: "bloomberg-economics"
    type: "rss"
    url: "https://www.bloomberg.com/feeds/economics/news.rss"
    interval: 300
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      # AI 只做翻译，不参与路由：全部进聚合，受 digest 配额约束。
      ai_policy: bypass
      on_ai_failure: silent
      digest: {max_per_day: 2, priority: 50, briefing_target: news_aggregate}
      default: digest
    options:
      max_age_hours: 4
      fetch_linked_body: false
      exclude_link_patterns:
        - "/videos/"
        - "/live/"
        - "/newsletters/"
        - "/podcasts/"
      tags: ["宏观", "经济", "Bloomberg"]

  # bloomberg-politics 已删除（2026-11-09）：32 条/日以政治口水为主，关税/制裁已被
  # bwe-tradfi 与 bloomberg-markets 覆盖；宏观大事口径下不再保留纯政治源。

  # ForexLive（investingLive 前身）突发快讯 —— 投行级宏观快讯：经济数据 vs 预期、地缘事件
  - name: "forexlive-breaking"
    type: "rss"
    url: "https://investinglive.com/feed/news"
    interval: 120  # 突发快讯，越快越好
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      # 价值投资口径：直推预算 3/日，经济数据超预期/央行与地缘例外不限量。
      ai_policy: bypass
      on_ai_failure: silent
      critical_keywords:
        - "FOMC"
        - "rate decision"
        - "非农"
        - "NFP"
        - "CPI"
        - "PCE"
        - "降息"
        - "降准"
        - "加息"
        - "tariff"
        - "sanction"
        - "ceasefire"
      direct: {max_per_day: 3, priority: 70}
      digest: {max_per_day: 0, priority: 50, briefing_target: news_aggregate}
      default: direct
    options:
      max_age_hours: 1
      # 每日要闻汇总会把几十条快讯拼成上万字符的长文；按句切分成 "- " 分点，
      # 短快讯（< bullet_min_runes）保持原样。
      format: "bullets"
      bullet_min_runes: 400
      tags: ["外汇", "宏观", "快讯"]

  # ── 中国 / AH ──

  # 金十数据 7x24 快讯（公开 JSON API）：中文一手宏观/政策/商品快讯。
  # 只保留 important=1 或命中宏观关键词的条目；个股公告类噪音在源内过滤。
  - name: "jin10"
    type: "jin10"
    interval: 120
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      ai_policy: bypass
      on_ai_failure: silent
      # critical 只放“事件短语”，不再放“央行/CPI/制裁”这类主题词：
      # 主题词出现即绕过每日配额，埃及央行、伊朗外交部表态也会被直推。
      critical_keywords:
        - "利率决议"
        - "FOMC"
        - "加息25个基点"
        - "降息25个基点"
        - "维持利率不变"
        - "降准"
        - "LPR"
        - "存款准备金率"
        - "熔断"
        - "暂停交易"
        - "债务违约"
        - "银行破产"
        - "封锁霍尔木兹"
      # critical 也要有日上限，防止以后某个关键词再次打穿配额。
      critical_max_per_day: 8
      direct: {max_per_day: 3, priority: 70}
      digest: {max_per_day: 6, priority: 60, briefing_target: news_aggregate}
      default: direct
    options:
      max_age_hours: 2
      limit: 40
      min_important: 1
      # 信噪比：实体+事件+数据发布+important 打分，低于阈值不进路由。
      # 0 = 回退旧的关键词 accept（不推荐）。
      score_threshold: 45
      # 把 section-news 多条目合集拆开逐条打分。
      split_roundups: true
      # 相同正文在窗口内只发一次（金十同内容会换 ID 重发）。
      dedupe_hours: 2
      tags: ["中国", "宏观", "金十"]
      # 个股公告（公告/减持/解禁/业绩预告…）不进实时推送，
      # 在源内按天攒着，每天 08:30 汇总成一条（窗口 30 分钟内只发一次）。
      noise_daily_summary: true
      noise_summary_time: "08:30"
      noise_summary_limit: 20

  # 华尔街见闻 7x24 快讯（2026-11-09 新增，补中国宏观与 AH 中文覆盖缺口）
  # 频道实测：hk-stock-channel 21 条/日，含中国 CPI/PPI、部委表态、港股监管，噪声低；
  # a-stock-channel 178 条/日（盘中个股异动为主）、global-channel 275 条/日（全量），
  # 两者只在需要时用 channels 配置追加，默认不接；接入高噪声频道时配 include_keywords
  # （如 a-stock-channel + ["证监会","国务院","回购","分红"]）只放行政策/监管类条目。
  # 重要度 score：1 常规 / 2 重要 / 3 头条；min_score 过滤掉常规条目。
  - name: "wallstcn-hk"
    type: "wallstcn"
    interval: 180
    sinks: ["wechat-main", "discord-webhook"]
    routing:
      # 直推预算 2/日；命中央行/数据/监管关键词不受配额限制。
      ai_policy: bypass
      on_ai_failure: silent
      critical_keywords:
        - "央行"
        - "人民银行"
        - "降准"
        - "降息"
        - "LPR"
        - "MLF"
        - "证监会"
        - "国务院"
        - "财政部"
        - "发改委"
        - "CPI"
        - "PPI"
        - "PMI"
        - "GDP"
        - "印花税"
        - "港股通"
        - "关税"
      direct: {max_per_day: 2, priority: 70}
      digest: {max_per_day: 6, priority: 60, briefing_target: news_aggregate}
      default: direct
    options:
      channels: ["hk-stock-channel"]
      limit: 30
      min_score: 2
      max_age_hours: 6
      exclude_keywords:
        - "提醒：日内请重点关注"
        - "早间要闻汇总"
        - "华尔街见闻早餐"
      tags: ["中国", "港股", "宏观"]

  # eia-energy 已删除（2026-11-09）：Today in Energy 是博客不是事件，0.4 条/日且与
  # 油价交易无关；周度库存数据需要时另做独立源，不混在新闻快讯里。

  # Energy Connects —— 已删除 (2026-08-02)：内容被其他源覆盖(能源地缘由
  # forexlive/bwe 承担),长期 enabled: false 死配置,代码一并清理。
  # Hellenic Shipping News —— 已关闭 (2026-07-31)
  # 理由: 48h 抓取 3,184 条，AI 拦截率 1.6%，80% 为航运业合规/安全/船舶回收等非交易噪音。

  # WSJ Markets 已移除（2026-06）：feeds.a.dj.com 公共 RSS 停更，feed 冻结在 2025-01-27，
  # Serenity 占位 stub 一并移除：从未配置 SERENITY_RSS_URL，长期 enabled: false 死配置。

  # ── 定时快照 ──

  - name: "guanfu-score"
    type: "guanfu"
    schedule: ["10:00"]
    sinks: ["wechat-main", "discord-webhook"]

  # ── 时段简报（2026-11-09：8 个定时源合并为按市场时段的 4 条）──
  # 每条消息 = 该时段的行情 + 宏观 + 日历 + 事件 + 资讯摘要，成员由现有源类型组装。
  # 盘中多槽（竞价/开盘/午盘/收盘），周度版次周日 20:00；成员失败只降级该段。

  # A 股盘中多槽：竞价 09:20 / 开盘 09:40 / 午盘 11:35 / 收盘 15:05。
  # 每个槽都重新租 digest（只取新到资讯），所以不是简单重复上一槽。
  # 盘后竞价 15:30 只影响科创板/创业板固定价交易，价值低且 16:10 有完整收盘报告，故不单独设槽。
  - name: "session-morning"
    type: "session"
    schedule: ["09:20", "09:40", "11:35", "15:05"]
    sinks: ["wechat-main", "discord-webhook"]
    options:
      session: "morning"
      title: "🌅 盘前全景"
      # 标题跟随行情成员相位（集合竞价/开盘/盘中/午盘/收盘），避免所有槽都叫“盘前全景”。
      title_from_member: true
      members:
        - label: "隔夜与盘前"
          type: "market-briefing"
          options:
            briefing_type: "pre_market"
            python_cmd: "python3"
            scripts_dir: "scripts"
        - label: "今日数据"
          type: "script"
          options:
            command: "python3 scripts/econ_calendar.py --days 1"
            timeout: 120
            push_output: true
        - label: "事件"
          type: "events"
          options:
            window_hours: 12
            limit: 6
        - label: "资讯摘要"
          type: "market-briefing"
          options:
            briefing_type: "aggregate"
            python_cmd: "python3"
            scripts_dir: "scripts"

  # A 股收盘 16:10：收盘行情/情绪 + 全天资讯摘要
  - name: "session-close"
    type: "session"
    schedule: ["16:10"]
    sinks: ["wechat-main", "discord-webhook"]
    options:
      session: "close"
      title: "📊 A股收盘"
      members:
        - label: "收盘行情"
          type: "market-briefing"
          options:
            briefing_type: "closing"
            # 每日市场全貌：指数/涨跌家数/成交额 + 热门板块 + 两融/主力资金 + 龙虎榜。
            # 打板预测(closing_scan)已随脚本下线；A/H 恐慌温度由 Go 侧自算，无需脚本。
            sections: ["sentiment", "hot_sector", "capital_flow", "lhb"]
            python_cmd: "python3"
            scripts_dir: "scripts"
        - label: "事件"
          type: "events"
          options:
            window_hours: 8
            limit: 8
        - label: "港股收盘"
          type: "market-briefing"
          options:
            briefing_type: "hk_close"
        - label: "美股夜盘"
          type: "market-briefing"
          options:
            briefing_type: "us_overnight"
        - label: "资讯摘要"
          type: "market-briefing"
          options:
            briefing_type: "aggregate"
            python_cmd: "python3"
            scripts_dir: "scripts"

  # 美盘前瞻：美东 09:00（北京夏令时 21:00 / 冬令时 22:00）。
  # 两个北京时间槽都排上，由美东实际时刻门控，只有对的那个会产出。
  - name: "session-us"
    type: "session"
    schedule: ["21:00", "22:00"]
    sinks: ["wechat-main", "discord-webhook"]
    options:
      session: "us"
      phase: "preopen"
      title: "🌎 美盘前瞻"
      members:
        - label: "美盘行情"
          type: "market-briefing"
          options:
            briefing_type: "us_preview"
            include_fedwatch: false  # FedWatch 由「美国宏观」成员统一给出
            python_cmd: "python3"
            scripts_dir: "scripts"
        - label: "美国宏观"
          type: "us-macro-report"
          options:
            api_key: "${FRED_API_KEY}"
            python_cmd: "python3"
            scripts_dir: "scripts"
            series:
              - "DFF"
              - "SOFR"
              - "DGS2"
              - "DGS10"
              - "DGS30"
              - "M2SL"
              - "WALCL"
              - "RRPONTSYD"
              - "TOTRESNS"
              - "T10Y2Y"
              - "T10Y3M"
              - "UNRATE"
              - "CPIAUCSL"
              - "PCEPI"
              - "DTWEXBGS"
              - "VIXCLS"
              - "BAA10Y"
              - "T10YIE"
              - "DCOILWTICO"
              - "BUFFETT_INDEX"
              - "CPILFESL"
              - "PCEPILFE"
              - "RSXFS"
              - "ICSA"
              - "LABOR_GAP"
        - label: "明日数据"
          type: "script"
          options:
            command: "python3 scripts/econ_calendar.py --days 1"
            timeout: 120
            push_output: true
        - label: "资讯摘要"
          type: "market-briefing"
          options:
            briefing_type: "aggregate"
            python_cmd: "python3"
            scripts_dir: "scripts"

  # 美盘收盘+盘后：美东 20:05（北京夏令时 08:05 / 冬令时 09:05）。
  # 16:00 常规收盘后还有 4 小时盘后交易，20:05 才能拿到完整盘后数据；
  # 北京时间正好在 A 股开盘前，顺带给出对 A 股/港股的板块映射。
  - name: "session-us-close"
    type: "session"
    schedule: ["08:05", "09:05"]
    sinks: ["wechat-main", "discord-webhook"]
    options:
      session: "us_close"
      title: "🌎 美盘收盘"
      members:
        - label: "美盘收盘"
          type: "market-briefing"
          options:
            briefing_type: "us_close"
            # 盘后大市值财报（Nasdaq 日历，非官方接口，失败自动降级）
            include_earnings: true
            earnings_min_cap_100m: 200   # 只列市值 ≥200 亿美元的盘后财报
            # 覆盖默认的 A 股产业链映射（key 用美股锚点）
            # ashare_map:
            #   NVDA: "算力/光模块/PCB：中际旭创、新易盛、沪电股份、工业富联"
            python_cmd: "python3"
            scripts_dir: "scripts"
        - label: "资讯摘要"
          type: "market-briefing"
          options:
            briefing_type: "aggregate"
            python_cmd: "python3"
            scripts_dir: "scripts"

  # 周度版次：调度器只支持 HH:MM，所以每天 20:00 触发，session=week 内部只在周日产出。
  # 内容为本周进入 instant/defer 的事件（events 成员直接读事件引擎，不新增脚本）。
  - name: "session-week"
    type: "session"
    schedule: ["20:00"]
    sinks: ["wechat-main", "discord-webhook"]
    options:
      session: "week"
      title: "🗓 周度版次"
      members:
        - label: "本周事件"
          type: "events"
          options:
            window_hours: 168
            limit: 20
            min_score: 40

  # 财报日历已删除（2026-11-09）：价值投资口径下财报不进 news 推送。

  # 机构 13F 追踪 —— 已关闭 (2026-07-31): 非季末无产出(EDGAR 仅季度披露)
  # 超级投资者 13F 追踪 —— 已关闭 (2026-07-31): 28s 跑出 0 字节(非季末无新披露)
  # global-macro 已移除(2026-07-18): 内容合并至收盘简报

# ── 事件模型（Story/Thread/Decision）────────────────────────────────────────
# off    = 关闭（零开销）
# shadow = 只记录身份归并、打分与来源贡献，不改变推送（建议先跑 1–2 周核对误判）
# active = 判定接管 typed routing：instant 直推、defer 进 news_aggregate、其余丢弃
#          （active 会改变线上推送，切换前先用 shadow 数据核对预算与误判）
events:
  mode: "shadow"
  location: "Asia/Shanghai"
  quiet_start: "23:30"
  quiet_end: "07:00"
  daily_budget: 6
  daily_hard_limit: 8
  class_reservation: 2
  instant_threshold: 75
  defer_threshold: 40
  quiet_bypass_score: 85
  story_window_hours: 24
  thread_window_hours: 12
  upgrade_delta: 15
  retention_days: 30

# ── 运行角色 ────────────────────────────────────────────────────────────────
# active  = 唯一摄入/推送（VPS）
# standby = 常驻只读，不摄入不投递（Mac）
# admin   = 只读 + 手动 FetchOnly（只抓不发）
# 双实例共用同一份配置时，用环境变量 NIMBUS_RUNTIME_ROLE 在宿主机覆盖。
runtime:
  role: "active"

market:
  default: "yahoo"
  providers:
    - name: "yahoo"
      type: "yahoo"
  smart_cache:
    enabled: true
    trading_ttl: 30
    closed_ttl: 600
    pre_market_ttl: 120
    after_hours_ttl: 120
    crypto_ttl: 30
    cache_size: 2000

# ── LLM ──────────────────────────────────────────────────────────────────────

llm:
  provider: "zhipu"
  api_url: "https://open.bigmodel.cn/api/paas/v4"
  api_key: "${GLM_API_KEY}"
  model: "glm-4-flash"            # 翻译 + 简评；免费
  heavy_model: "glm-4-flash"      # 报告解读也用同一模型，避免请求不存在的 deepseek 模型
  thinking_mode: "disabled"
  enhance:
    enabled: true
    max_per_hour: 20

# ── Filters ───────────────────────────────────────────────────────────────────

filters:
  content:
    enabled: true
    min_content_length: 15
    block_keywords:
      - "(?i)^https?://"
      - "(?i)^(rt|retweet)\\s*[@:]"
      - "(?i)\\[video\\]"
      - "(?i)\\[image\\]"
      - "(?i)^watch\\s*:?\\s*https?://"
      - "(?i)^live\\s*:?\\s*https?://"
      - "(?i)^🔴\\s*(live|breaking)\\s*$"
      - "(?i)^pic\\.twitter\\.com"

  dedup:
    enabled: true
    ttl: 43200  # 12h，配合 max_age_hours: 12
    groups:
      # energy-connects 已禁用(2026-07-31),不在去重组(2026-08-02 清理)
      # 2026-11-04：walter-bloomberg 加入跨源去重组，避免同一标题被 bwe-tradfi 与
      # 快讯源各推一遍；trump-rss / first-squawk 已移除。
      # 2026-11-09：金十加入去重组，和 wallstcn 同覆盖中国宏观，避免同一数据/政策各推一遍。
      - ["bwe-tradfi", "kobeissi-letter", "forexlive-breaking",
         "fed-press", "bloomberg-markets", "bloomberg-economics",
         "wallstcn-hk", "jin10"]
    semantic:
      enabled: true
      threshold: 0.75
      time_window: 5400
      cache_size: 2000

  ratelimit:
    enabled: true
    rules:
      - source: "*"
        sink: "wechat-main"
        max_per_minute: 100
      - source: "*"
        sink: "discord-webhook"
        max_per_minute: 100
      - source: "us-macro-report"
        sink: "*"
        max_per_minute: 10
      - source: "guanfu-score"
        sink: "*"
        max_per_minute: 10
      - source: "*"
        sink: "*"
        max_per_minute: 100

  # ai_filter 现在是阻塞式门禁（评分<6 或 无价值/无关 直接拦截），不再只打分。
  ai_filter:
    enabled: true
    threshold_score: 6.5  # 2026-07-31: 7.5→6.5 — score 7 条目(重要信号)此前全被误杀,24条/天漏诊
    max_per_minute: 30
    global_max_per_minute: 60
    block_categories:
      - "无价值"
      - "无关"
    target_sources:
      - "bwe-tradfi"
      - "kobeissi-letter"
      - "fed-press"
      - "bloomberg-markets"
      - "bloomberg-economics"
      - "forexlive-breaking"
# ── Source Health ─────────────────────────────────────────────────────────────

source_health:
  enabled: true
  degraded_threshold: 3
  unhealthy_threshold: 5
  # 高频源（间隔 ≤5 分钟）连续抓取 0 条也降级：上游停更/过滤过严不会让 Fetch 报错。
  empty_degraded_threshold: 6
  recovery_interval: 300
  renotify_interval: 21600   # 持续 unhealthy 期间每 6h 重复告警
  # 健康状态只写入日志与 /metrics，不推送任何消息。
  notify_channels: []

# ── Alert ─────────────────────────────────────────────────────────────────────

alert:
  enabled: true
  check_interval: 30
  max_alerts_per_user: 50
  default_cooldown: 300
